<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>ModernNotepad.App</RootNamespace>
    <AssemblyName>ModernNotepad</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Product>Modern Notepad</Product>
    <Company>Modern Notepad Contributors</Company>
    <Description>Offline-first rich text editor with optional local or OpenAI grammar analysis.</Description>
    <Version>1.0.0</Version>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ModernNotepad.Core\ModernNotepad.Core.csproj" />
  </ItemGroup>
</Project>
