<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#F7F8FC</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#EEF1F8</Color>
    <Color x:Key="SurfaceElevatedColor">#FFFFFF</Color>
    <Color x:Key="EditorBackgroundColor">#FEFEFF</Color>
    <Color x:Key="TextColor">#1F2937</Color>
    <Color x:Key="MutedTextColor">#6B7280</Color>
    <Color x:Key="BorderColor">#E2E5EF</Color>
    <Color x:Key="HoverColor">#EDF0F8</Color>
    <Color x:Key="SelectedColor">#DDE7FF</Color>
    <Color x:Key="StatusBarColor">#EAEFF6</Color>
    <Color x:Key="FocusRingColor">#4F6BED</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="{StaticResource EditorBackgroundColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="{StaticResource StatusBarColor}" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRingColor}" />

    <SolidColorBrush x:Key="ErrorBrush" Color="#B42318" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B54708" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#027A48" />
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#15B42318" />
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="#15B54708" />
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#15027A48" />

    <SolidColorBrush x:Key="AccentBrush" Color="#4F6BED" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#405BCB" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#224F6BED" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#154F6BED" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4F6BED" Offset="0" />
        <GradientStop Color="#7C5CFC" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StatusBarGradientBorderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E2E5EF" Offset="0" />
        <GradientStop Color="#CDD3E2" Offset="0.5" />
        <GradientStop Color="#E2E5EF" Offset="1" />
    </LinearGradientBrush>

    <!-- Saved/Unsaved/Failed status dot colors -->
    <SolidColorBrush x:Key="StatusSavedBrush" Color="#027A48" />
    <SolidColorBrush x:Key="StatusUnsavedBrush" Color="#B54708" />
    <SolidColorBrush x:Key="StatusFailedBrush" Color="#B42318" />
</ResourceDictionary>
