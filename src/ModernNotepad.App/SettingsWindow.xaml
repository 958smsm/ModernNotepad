<Window x:Class="ModernNotepad.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — Modern Notepad"
        Width="720"
        Height="690"
        MinWidth="620"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0,0,0,12"
                                   Text="Editor defaults" />

                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsLabelStyle}" Text="Default font" />
                        <ComboBox x:Name="DefaultFontCombo"
                                  Grid.Row="1" Grid.Column="1"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  AutomationProperties.Name="Default font" />

                        <TextBlock Grid.Row="2" Style="{StaticResource SettingsLabelStyle}" Text="Default font size" />
                        <TextBox x:Name="DefaultFontSizeTextBox"
                                 Grid.Row="2" Grid.Column="1"
                                 MaxLength="6"
                                 AutomationProperties.Name="Default font size" />

                        <TextBlock Grid.Row="3" Style="{StaticResource SettingsLabelStyle}" Text="Default file format" />
                        <ComboBox x:Name="DefaultFormatCombo"
                                  Grid.Row="3" Grid.Column="1"
                                  AutomationProperties.Name="Default file format">
                            <ComboBoxItem Content="Plain text (.txt)" Tag=".txt" />
                            <ComboBoxItem Content="Rich text (.rtf)" Tag=".rtf" />
                            <ComboBoxItem Content="Markdown (.md)" Tag=".md" />
                            <ComboBoxItem Content="YAML (.yaml)" Tag=".yaml" />
                            <ComboBoxItem Content="YAML (.yml)" Tag=".yml" />
                            <ComboBoxItem Content="JSON (.json)" Tag=".json" />
                            <ComboBoxItem Content="XML (.xml)" Tag=".xml" />
                        </ComboBox>

                        <TextBlock Grid.Row="4" Style="{StaticResource SettingsLabelStyle}" Text="Auto-save interval (seconds)" />
                        <TextBox x:Name="AutoSaveTextBox"
                                 Grid.Row="4" Grid.Column="1"
                                 MaxLength="5"
                                 AutomationProperties.Name="Auto-save interval in seconds" />

                        <TextBlock Grid.Row="5" Style="{StaticResource SettingsLabelStyle}" Text="Spell-check language" />
                        <ComboBox x:Name="SpellLanguageCombo"
                                  Grid.Row="5" Grid.Column="1"
                                  IsEditable="True"
                                  AutomationProperties.Name="Spell-check language">
                            <ComboBoxItem Content="English (United States) — en-US" Tag="en-US" />
                            <ComboBoxItem Content="English (United Kingdom) — en-GB" Tag="en-GB" />
                            <ComboBoxItem Content="French — fr-FR" Tag="fr-FR" />
                            <ComboBoxItem Content="German — de-DE" Tag="de-DE" />
                            <ComboBoxItem Content="Spanish — es-ES" Tag="es-ES" />
                        </ComboBox>

                        <CheckBox x:Name="WordWrapCheckBox"
                                  Grid.Row="6" Grid.ColumnSpan="2"
                                  Margin="0,10,0,2"
                                  Content="Wrap long lines"
                                  AutomationProperties.Name="Wrap long lines" />
                        <CheckBox x:Name="TabsCheckBox"
                                  Grid.Row="7" Grid.ColumnSpan="2"
                                  Margin="0,5,0,2"
                                  Content="Enable document tabs"
                                  AutomationProperties.Name="Enable document tabs" />
                        <CheckBox x:Name="RestoreSessionCheckBox"
                                  Grid.Row="8" Grid.ColumnSpan="2"
                                  Margin="0,5,0,2"
                                  Content="Restore the previous session at startup"
                                  AutomationProperties.Name="Restore previous session" />
                        <TextBlock Grid.Row="9" Grid.ColumnSpan="2"
                                   Margin="0,12,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Recovery snapshots are stored locally and are removed after a document is saved or intentionally discarded." />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0,0,0,12"
                                   Text="Theme" />
                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsLabelStyle}" Text="Color mode" />
                        <ComboBox x:Name="ThemeCombo"
                                  Grid.Row="1" Grid.Column="1"
                                  AutomationProperties.Name="Color mode">
                            <ComboBoxItem Content="Light" Tag="Light" />
                            <ComboBoxItem Content="Dark" Tag="Dark" />
                        </ComboBox>

                        <TextBlock Grid.Row="2" Style="{StaticResource SettingsLabelStyle}" Text="Accent color" />
                        <DockPanel Grid.Row="2" Grid.Column="1">
                            <Border x:Name="AccentPreview"
                                    DockPanel.Dock="Right"
                                    Width="34" Height="28"
                                    Margin="8,2,2,2"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4" />
                            <TextBox x:Name="AccentColorTextBox"
                                     AutomationProperties.Name="Accent color hexadecimal value"
                                     TextChanged="ColorTextBox_TextChanged" />
                        </DockPanel>

                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
                                   Margin="0,14,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Enter colors as #RRGGBB or #AARRGGBB. Theme changes are applied after saving settings." />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Smart features">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0,0,0,8"
                                   Text="Optional analysis" />
                        <CheckBox x:Name="SmartColoringCheckBox"
                                  Grid.Row="1" Grid.ColumnSpan="2"
                                  Content="Enable Smart Coloring"
                                  AutomationProperties.Name="Enable Smart Coloring" />
                        <CheckBox x:Name="DuplicateDetectionCheckBox"
                                  Grid.Row="2" Grid.ColumnSpan="2"
                                  Margin="0,5,0,0"
                                  Content="Enable duplicate-text detection"
                                  AutomationProperties.Name="Enable duplicate-text detection" />
                        <CheckBox x:Name="SmartPanelCheckBox"
                                  Grid.Row="3" Grid.ColumnSpan="2"
                                  Margin="0,5,0,8"
                                  Content="Show the writing-assistance panel"
                                  AutomationProperties.Name="Show writing-assistance panel" />

                        <TextBlock Grid.Row="4" Style="{StaticResource SettingsLabelStyle}" Text="Duplicate threshold" />
                        <TextBox x:Name="DuplicateThresholdTextBox"
                                 Grid.Row="4" Grid.Column="1"
                                 MaxLength="4"
                                 AutomationProperties.Name="Duplicate threshold" />

                        <TextBlock Grid.Row="5" Style="{StaticResource SettingsLabelStyle}" Text="Duplicate highlight color" />
                        <TextBox x:Name="DuplicateColorTextBox"
                                 Grid.Row="5" Grid.Column="1"
                                 AutomationProperties.Name="Duplicate highlight color"
                                 TextChanged="ColorTextBox_TextChanged" />

                        <CheckBox x:Name="StrictDuplicatesCheckBox"
                                  Grid.Row="6" Grid.ColumnSpan="2"
                                  Margin="0,5,0,8"
                                  Content="Strict checking (include common words)"
                                  AutomationProperties.Name="Strict duplicate checking" />

                        <TextBlock Grid.Row="7" Style="{StaticResource SettingsLabelStyle}" Text="Long-sentence threshold (words)" />
                        <TextBox x:Name="LongSentenceTextBox"
                                 Grid.Row="7" Grid.Column="1"
                                 MaxLength="4"
                                 AutomationProperties.Name="Long sentence threshold" />

                        <CheckBox x:Name="PassiveVoiceCheckBox"
                                  Grid.Row="8" Grid.ColumnSpan="2"
                                  Margin="0,5,0,8"
                                  Content="Detect likely passive voice"
                                  AutomationProperties.Name="Detect passive voice" />

                        <TextBlock Grid.Row="9" Style="{StaticResource SettingsLabelStyle}" Text="Maximum visual highlights" />
                        <TextBox x:Name="MaxSpansTextBox"
                                 Grid.Row="9" Grid.Column="1"
                                 MaxLength="6"
                                 AutomationProperties.Name="Maximum visual highlights" />

                        <TextBlock Grid.Row="10" Grid.ColumnSpan="2"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Text="Grammar-category colors" />
                        <Grid Grid.Row="11" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,5">
                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Subjects / nouns" />
                                <TextBox x:Name="SubjectColorTextBox" AutomationProperties.Name="Subject and noun color" TextChanged="ColorTextBox_TextChanged" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,5">
                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Verbs" />
                                <TextBox x:Name="VerbColorTextBox" AutomationProperties.Name="Verb color" TextChanged="ColorTextBox_TextChanged" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,5">
                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Objects / nouns" />
                                <TextBox x:Name="ObjectColorTextBox" AutomationProperties.Name="Object and noun color" TextChanged="ColorTextBox_TextChanged" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,5">
                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Adjectives" />
                                <TextBox x:Name="AdjectiveColorTextBox" AutomationProperties.Name="Adjective color" TextChanged="ColorTextBox_TextChanged" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,5">
                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Adverbs" />
                                <TextBox x:Name="AdverbColorTextBox" AutomationProperties.Name="Adverb color" TextChanged="ColorTextBox_TextChanged" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,5">
                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Pronouns" />
                                <TextBox x:Name="PronounColorTextBox" AutomationProperties.Name="Pronoun color" TextChanged="ColorTextBox_TextChanged" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,5">
                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Prepositions" />
                                <TextBox x:Name="PrepositionColorTextBox" AutomationProperties.Name="Preposition color" TextChanged="ColorTextBox_TextChanged" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,5">
                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Conjunctions" />
                                <TextBox x:Name="ConjunctionColorTextBox" AutomationProperties.Name="Conjunction color" TextChanged="ColorTextBox_TextChanged" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left"
                    Content="Restore defaults"
                    Click="RestoreDefaults_Click" />
            <Button DockPanel.Dock="Right"
                    Content="Save"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="90"
                    IsDefault="True"
                    Click="Save_Click" />
            <Button DockPanel.Dock="Right"
                    Content="Cancel"
                    MinWidth="90"
                    IsCancel="True" />
        </DockPanel>
    </Grid>
</Window>
