<UserControl x:Class="ModernNotepad.App.Views.EditorDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <Grid Background="{DynamicResource EditorBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="FindBar"
                Grid.Row="0"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8"
                Visibility="Collapsed">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Content="✕"
                        ToolTip="Close find bar (Esc)"
                        AutomationProperties.Name="Close find bar"
                        Click="CloseFindBar_Click" />
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Margin="4,0,4,0" VerticalAlignment="Center" Text="Find" />
                    <TextBox x:Name="FindTextBox"
                             Width="200"
                             AutomationProperties.Name="Find text"
                             TextChanged="FindTextBox_TextChanged"
                             KeyDown="FindTextBox_KeyDown" />
                    <TextBlock x:Name="ReplaceLabel"
                               Margin="12,0,4,0"
                               VerticalAlignment="Center"
                               Text="Replace"
                               Visibility="Collapsed" />
                    <TextBox x:Name="ReplaceTextBox"
                             Width="180"
                             AutomationProperties.Name="Replacement text"
                             KeyDown="ReplaceTextBox_KeyDown"
                             Visibility="Collapsed" />
                    <CheckBox x:Name="MatchCaseCheckBox"
                              Margin="10,0,6,0"
                              VerticalAlignment="Center"
                              Content="Match case"
                              AutomationProperties.Name="Match case" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Content="↑"
                            ToolTip="Find previous"
                            AutomationProperties.Name="Find previous"
                            Click="FindPrevious_Click" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Content="↓"
                            ToolTip="Find next"
                            AutomationProperties.Name="Find next"
                            Click="FindNext_Click" />
                    <Button x:Name="ReplaceButton"
                            Content="Replace"
                            Visibility="Collapsed"
                            Click="Replace_Click" />
                    <Button x:Name="ReplaceAllButton"
                            Content="Replace all"
                            Visibility="Collapsed"
                            Click="ReplaceAll_Click" />
                    <TextBlock x:Name="FindStatusText"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <RichTextBox x:Name="Editor"
                     Grid.Row="1"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     AllowDrop="False"
                     AutoWordSelection="False"
                     Background="{DynamicResource EditorBackgroundBrush}"
                     Foreground="{DynamicResource TextBrush}"
                     CaretBrush="{DynamicResource TextBrush}"
                     BorderThickness="0"
                     Padding="0"
                     IsDocumentEnabled="True"
                     IsInactiveSelectionHighlightEnabled="True"
                     IsUndoEnabled="True"
                     UndoLimit="250"
                     SelectionBrush="{DynamicResource AccentBrush}"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Hidden"
                     SpellCheck.IsEnabled="True"
                     TextChanged="Editor_TextChanged"
                     SelectionChanged="Editor_SelectionChanged"
                     PreviewMouseWheel="Editor_PreviewMouseWheel"
                     PreviewKeyDown="Editor_PreviewKeyDown" />
    </Grid>
</UserControl>
